{% extends "@UxDsfr/demo/components.html.twig" %}

{% block text_content %}
    <h1 class="fr-h1">Badge</h1>
    <div class="fr-mt-4v">
        <twig:UxDsfr:Callout color="blue-ecume">
            <p class="fr-mb-0">Le composant <code>Badge</code> met en avant un statut, une catégorie ou une information courte avec une couleur codifiée.</p>
        </twig:UxDsfr:Callout>
    </div>

    <div class="fr-mt-4v">
        <h2 class="fr-h2">Types</h2>
        <h3 class="fr-h4">Rendu</h3>
        <div class="fr-mt-4v">
            <div class="fr-mt-2v">
                <twig:UxDsfr:Badge type="info" content="Info"/>
                <twig:UxDsfr:Badge type="warning" content="Warning"/>
                <twig:UxDsfr:Badge type="error" content="Error"/>
                <twig:UxDsfr:Badge type="success" content="Success"/>
                <twig:UxDsfr:Badge type="new" content="New"/>
                <twig:UxDsfr:Badge :type="null" content="Neutre"/>
            </div>
        </div>
        <div class="fr-mt-4v">
            <p><strong>Code snippet</strong></p>
            {% set code3 = "&lt;twig:UxDsfr:Badge type=\"info\" content=\"Info\" /&gt;
&lt;twig:UxDsfr:Badge type=\"warning\" content=\"Warning\" /&gt;
&lt;twig:UxDsfr:Badge type=\"error\" content=\"Error\" /&gt;
&lt;twig:UxDsfr:Badge type=\"success\" content=\"Success\" /&gt;
&lt;twig:UxDsfr:Badge type=\"new\" content=\"New\" /&gt;
&lt;twig:UxDsfr:Badge :type=\"null\" content=\"Neutre\" /&gt;" %}
            <twig:UxDsfr:Highlight>
                <pre><code class="language-html">{{ code3|raw }}</code></pre>
            </twig:UxDsfr:Highlight>
        </div>
        <h2 class="fr-h2">Tailles</h2>
        <div class="fr-mt-4v">
            <div class="fr-mt-2v">
                <twig:UxDsfr:Badge size="sm" content="Small"/>
                <twig:UxDsfr:Badge size="md" content="Medium"/>
            </div>
        </div>
        <div class="fr-mt-4v">
            <p><strong>Code snippet</strong></p>
            {% set code4 = "&lt;twig:UxDsfr:Badge size=\"sm\" content=\"Small\" /&gt;
&lt;twig:UxDsfr:Badge size=\"md\" content=\"Medium\" /&gt;" %}
            <twig:UxDsfr:Highlight>
                <pre><code class="language-html">{{ code4|raw }}</code></pre>
            </twig:UxDsfr:Highlight>
        </div>
        <h2 class="fr-h2">Sans icône</h2>
        <div class="fr-mt-4v">
            <div class="fr-mt-2v">
                <twig:UxDsfr:Badge type="success" :icon="false" content="Succès"/>
            </div>
        </div>
        <div class="fr-mt-4v">
            <p><strong>Code snippet</strong></p>
            {% set code5 = "&lt;twig:UxDsfr:Badge type=\"success\" :icon=\"false\" content=\"Succès\" /&gt;" %}
            <twig:UxDsfr:Highlight>
                <pre><code class="language-html">{{ code5|raw }}</code></pre>
            </twig:UxDsfr:Highlight>
        </div>
        <h2 class="fr-h2">Couleurs d’accentuation</h2>
        <p><code>color</code> remplace le type système.</p>
        <div class="fr-mt-4v">
            <div class="fr-mt-2v">
                <twig:UxDsfr:Badge color="green-menthe" content="Green menthe"/>
                <twig:UxDsfr:Badge color="purple-glycine" content="Purple glycine"/>
            </div>
        </div>
        <div class="fr-mt-4v">
            <p><strong>Code snippet</strong></p>
            {% set code6 = "&lt;twig:UxDsfr:Badge color=\"green-menthe\" content=\"Green menthe\" /&gt;" %}
            <twig:UxDsfr:Highlight>
                <pre><code class="language-html">{{ code6|raw }}</code></pre>
            </twig:UxDsfr:Highlight>
        </div>
        <h2 class="fr-h2">Balise</h2>
        <p>Le badge est un <code>&lt;p&gt;</code> ; <code>tag="span"</code> le place dans un lien, une cellule de tableau ou un groupe de badges.</p>
        <div class="fr-mt-4v">
            <ul class="fr-badges-group">
                <li><twig:UxDsfr:Badge tag="span" type="info" content="Badge 1"/></li>
                <li><twig:UxDsfr:Badge tag="span" type="success" content="Badge 2"/></li>
            </ul>
        </div>
        <div class="fr-mt-4v">
            <p><strong>Code snippet</strong></p>
            {% set code7 = "&lt;ul class=\"fr-badges-group\"&gt;
    &lt;li&gt;&lt;twig:UxDsfr:Badge tag=\"span\" type=\"info\" content=\"Badge 1\" /&gt;&lt;/li&gt;
    &lt;li&gt;&lt;twig:UxDsfr:Badge tag=\"span\" type=\"success\" content=\"Badge 2\" /&gt;&lt;/li&gt;
&lt;/ul&gt;" %}
            <twig:UxDsfr:Highlight>
                <pre><code class="language-html">{{ code7|raw }}</code></pre>
            </twig:UxDsfr:Highlight>
        </div>
    </div>
{% endblock %}

