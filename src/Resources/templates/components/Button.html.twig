{% set content %}{% block content %}{% endblock %}{% endset %}
{% set classes = [
    'fr-btn',
    variant != 'primary' ? 'fr-btn--' ~ variant,
    size != 'md' ? 'fr-btn--' ~ size,
    icon ? 'fr-icon-' ~ icon,
    icon and iconPosition in ['left', 'right'] ? 'fr-btn--icon-' ~ iconPosition,
]|filter(c => c)|join(' ') %}
{% set defaults = {'class': classes}|merge(icon and iconPosition == 'only' ? {'title': content|striptags|trim} : {}) %}
{% if href %}
{# A disabled link has no href (DSFR link component) #}
<a {{ attributes.defaults(defaults|merge(disabled ? {'role': 'link', 'aria-disabled': 'true'} : {'href': href})) }}>
    {{ content }}
</a>
{% else %}
<button {{ attributes.defaults(defaults|merge({'type': type})) }}{% if disabled %} disabled{% endif %}>
    {{ content }}
</button>
{% endif %}
