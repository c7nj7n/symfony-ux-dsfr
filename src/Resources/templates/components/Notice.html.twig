<div {{ attributes.defaults({'class': 'fr-notice fr-notice--' ~ type ~ (icon is same as(false) ? ' fr-notice--no-icon' : '')}) }}>
    <div class="fr-container">
        <div class="fr-notice__body">
            <p>
                <span class="fr-notice__title{{ icon ? ' fr-icon-' ~ icon }}">{{ title }}</span>
                {% if description %}
                    <span class="fr-notice__desc">{{ description }}</span>
                {% endif %}
                {% if link %}
                    {% set label = linkLabel ?? link %}
                    <a class="fr-notice__link" href="{{ link }}"{% if newWindow %} target="_blank" rel="noopener external" title="{{ label }} - {{ 'utils.new_window'|trans({}, 'dsfr') }}"{% endif %}>{{ label }}</a>
                {% endif %}
            </p>
            {% if closable %}
                <button title="{{ 'alert.closable_label'|trans({}, 'dsfr') }}"
                        onclick="const notice = this.parentNode.parentNode.parentNode; notice.parentNode.removeChild(notice)"
                        type="button"
                        class="fr-btn--close fr-btn"
                >
                    {{ 'alert.closable_label'|trans({}, 'dsfr') }}
                </button>
            {% endif %}
        </div>
    </div>
</div>
