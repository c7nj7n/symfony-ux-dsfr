{% set logo_name %}
    {%- block content -%}
        {%- for line in (title ?? 'République<br>Française')|split('<br>') -%}
            {{ line }}{% if not loop.last %}<br>{% endif %}
        {%- endfor -%}
    {%- endblock -%}
{% endset %}
<div class="fr-header__logo">
    <twig:UxDsfr:GouvLogo>{{ logo_name }}</twig:UxDsfr:GouvLogo>
</div>
{% if service_logo %}
    <div class="fr-header__operator">
        <img alt="{{ service_logo_alt }}" class="fr-responsive-img" src="{{ service_logo }}" style="width: 3.5rem">
    </div>
{% endif %}
