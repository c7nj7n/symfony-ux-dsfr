{% set logo_text = logo_title ?? 'République<br>Française' %}
{% set service_text %}{% block brand_service_title %}{{ service_title }}{% endblock %}{% endset %}
{% set service_tag_text %}{% block brand_service_tag %}{{ service_tagline }}{% endblock %}{% endset %}
{% set plain_service = service_title ?? service_text|striptags|trim %}
<div {{ attributes.defaults({ 'class':'fr-header__brand fr-enlarge-link' }) }}>
    <div class="fr-header__brand-top">
        <twig:UxDsfr:Header:Logo :service_logo="service_logo" :service_logo_alt="service_logo_alt ?? plain_service" :title="logo_text" />
        {% if show_search_button or show_menu_button %}
            <div class="fr-header__navbar">
                {% if show_search_button %}
                    <button aria-controls="{{ search_modal_id }}" class="fr-btn--search fr-btn" data-fr-opened="false" id="{{ search_modal_id }}-button" title="{{ 'utils.search'|trans({}, 'dsfr') }}" type="button">
                        {{ 'utils.search'|trans({}, 'dsfr') }}
                    </button>
                {% endif %}
                {% if show_menu_button %}
                    <button aria-controls="{{ menu_id }}" class="fr-btn--menu fr-btn" data-fr-opened="false" id="{{ menu_id }}-button" title="{{ 'utils.menu'|trans({}, 'dsfr') }}" type="button">
                        {{ 'utils.menu'|trans({}, 'dsfr') }}
                    </button>
                {% endif %}
            </div>
        {% endif %}
    </div>
    <twig:UxDsfr:Header:Service
        :link="service_link"
        :link_title="service_link_title ?? ('header.home'|trans({}, 'dsfr') ~ ' - ' ~ plain_service ~ ' - ' ~ logo_text|replace({'<br>': ' '}))"
        :badges="service_badges"
    >
        {% block service_title %}{{ service_text }}{% endblock %}
        {% block service_tag %}{{ service_tag_text }}{% endblock %}
    </twig:UxDsfr:Header:Service>
</div>
