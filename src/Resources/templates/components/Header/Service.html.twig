{% set titleline %}{% block service_title %}{{ title }}{% endblock %}{% endset %}
{% set tagline_text %}{% block service_tag %}{{ tagline }}{% endblock %}{% endset %}
{% set plain_title = title ?? titleline|striptags|trim %}
<div {{ attributes.defaults({ 'class':'fr-header__service' }) }}>
    <a href="{{ link ?? '/' }}" title="{{ link_title ?? ('header.home'|trans({}, 'dsfr') ~ ' - ' ~ plain_title) }}">
        <p class="fr-header__service-title">
            {{ titleline }}
            {%- if badges %} {{ badges }}{% endif %}
        </p>
    </a>
    {% if tagline_text|trim %}<p class="fr-header__service-tagline">{{ tagline_text }}</p>{% endif %}
</div>
