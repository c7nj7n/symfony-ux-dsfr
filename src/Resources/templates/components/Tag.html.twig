{% set classes = ['fr-tag'] %}
{% set content %}{% block content %}{% endblock %}{% endset %}
{% if size != 'md' %}{% set classes = classes|merge(['fr-tag--' ~ size]) %}{% endif %}
{% if variant != 'default' %}{% set classes = classes|merge(['fr-tag--' ~ variant]) %}{% endif %}
{% if icon %}{% set classes = classes|merge(['fr-icon-' ~ icon, 'fr-tag--icon-left']) %}{% endif %}
{% if pressable %}{% set classes = classes|merge(['fr-tag--clickable']) %}{% endif %}
{% if dismissable %}{% set classes = classes|merge(['fr-tag--dismiss']) %}{% endif %}
{% set classes = classes|join(' ') %}

{% if href and not pressable %}
    {% if disabled %}
        <a {{ attributes.defaults({class: classes, 'aria-disabled': 'true', role: 'link'}|merge(title ? {title: title} : {})) }}>
            {{- content -}}
        </a>
    {% else %}
        <a {{ attributes.defaults({class: classes, href: href}|merge(title ? {title: title} : {})|merge(target and target != '_self' ? {target: target} : {})|merge(target == '_blank' ? {rel: 'noopener noreferrer'} : {})) }}>
            {{- content -}}
        </a>
    {% endif %}
{% elseif dismissable %}
    {# The DSFR asks for "Retirer <label>" as the button's name #}
    <button {{ attributes.defaults({class: classes, type: type, 'aria-label': title ?? 'tag.dismiss'|trans({'%label%': content|striptags|trim}, 'dsfr')}|merge(disabled ? {disabled: true} : {})) }}>
        {{- content -}}
    </button>
{% elseif pressable %}
    <button {{ attributes.defaults({class: classes, type: type, 'aria-pressed': pressed ? 'true' : 'false'}|merge(title ? {title: title} : {})|merge(disabled ? {disabled: true} : {})) }}>
        {{- content -}}
    </button>
{% else %}
    <{{ tag }} {{ attributes.defaults({class: classes}|merge(title ? {title: title} : {})) }}>
        {{- content -}}
    </{{ tag }}>
{% endif %}
