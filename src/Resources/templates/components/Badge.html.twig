{% set variant = color ? 'fr-badge--' ~ color : (type ? 'fr-badge--' ~ type ~ (icon ? '' : ' fr-badge--no-icon')) %}
<{{ tag }} {{ attributes.defaults({'class': ['fr-badge', variant, size == 'sm' ? 'fr-badge--sm']|filter(c => c)|join(' ')}) }}>
    {%- if ellipsis %}<span class="fr-ellipsis">{% endif -%}
    {% block content %}{{ content }}{% endblock %}
    {%- if ellipsis %}</span>{% endif -%}
</{{ tag }}>
