{# src/Resources/templates/components/Breadcrumb.html.twig #}
<nav {{ attributes.defaults({ 'role': 'navigation', 'class': 'fr-breadcrumb', 'aria-label': 'breadcrumb.label'|trans({}, 'dsfr') }) }}>
    <button class="fr-breadcrumb__button" aria-expanded="false" aria-controls="{{ id }}">{{ 'breadcrumb.button'|trans({}, 'dsfr') }}</button>
    <div class="fr-collapse" id="{{ id }}">
        <ol class="fr-breadcrumb__list">
            {% for item in items %}
                <li>
                    {% if item.href is defined and item.href %}
                        <a class="fr-breadcrumb__link" href="{{ item.href }}">{{ item.label }}</a>
                    {% else %}
                        <a class="fr-breadcrumb__link" aria-current="page">{{ item.label }}</a>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </div>
</nav>
