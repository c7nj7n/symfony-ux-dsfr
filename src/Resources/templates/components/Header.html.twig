{% set header_navigation %}{% block header_navigation %}{% endblock %}{% endset %}
{% set header_tools %}{% block header_tools %}{% endblock %}{% endset %}
{% set service_badges %}{% block service_badges %}{% endblock %}{% endset %}
{% if skiplinks %}
    <twig:UxDsfr:Skiplinks :links="skiplinks" />
{% endif %}
<header {{ attributes.defaults({ 'role':'banner', 'class':'fr-header' }) }}>
    <div class="fr-header__body">
        <div class="fr-container">
            <div class="fr-header__body-row">
                <twig:UxDsfr:Header:Brand
                    :service_link="service_link"
                    :service_link_title="service_link_title"
                    :service_logo="service_logo"
                    :service_logo_alt="service_logo_alt"
                    :logo_title="logo_title"
                    :service_title="service_title"
                    :service_tagline="service_tagline"
                    :service_badges="service_badges|trim ? service_badges : null"
                    :show_menu_button="show_menu_button or header_navigation|trim or header_tools|trim"
                    :show_search_button="show_search_button"
                    :search_modal_id="search_modal_id"
                    :menu_id="menu_id"
                >
                    {% block brand_service_title %}{{ service_title }}{% endblock %}
                    {% block brand_service_tag %}{{ service_tagline }}{% endblock %}
                </twig:UxDsfr:Header:Brand>
                {% if header_tools|trim or show_search_button or availables_languages|length > 1 %}
                    <div class="fr-header__tools">
                        {% if header_tools|trim or availables_languages|length > 1 %}
                            <div class="fr-header__tools-links">
                                {{ header_tools }}
                                {% if availables_languages|length > 1 %}
                                    <twig:UxDsfr:Header:ToolsMenu
                                        id="translate-collapse"
                                        :label="app.request.locale|upper"
                                        :hint="availables_languages[app.request.locale].label ?? null"
                                        :title="'utils.select_language'|trans({}, 'dsfr')"
                                        :items="availables_languages|map((language, key) => language|merge({lang: key, current: key == app.request.locale}))"
                                        class="fr-translate"
                                    />
                                {% endif %}
                            </div>
                        {% endif %}
                        {% if show_search_button %}
                            {% block search_form %}
                                <div aria-labelledby="{{ search_modal_id }}-button" class="fr-header__search fr-modal" id="{{ search_modal_id }}">
                                    <div class="fr-container fr-container-lg--fluid">
                                        <button aria-controls="{{ search_modal_id }}" class="fr-btn--close fr-btn" title="{{ 'utils.close'|trans({}, 'dsfr') }}" type="button">
                                            {{ 'utils.close'|trans({}, 'dsfr') }}
                                        </button>
                                        <form{% if search.formAction %} action="{{ search.formAction }}"{% endif %} class="fr-search-bar" id="{{ search_modal_id }}-form" method="{{ search.formMethod }}" role="search">
                                            <label class="fr-label" for="{{ search_modal_id }}-input">
                                                {{ 'utils.search'|trans({}, 'dsfr') }}
                                            </label>
                                            <input aria-describedby="{{ search_modal_id }}-input-messages" class="fr-input" id="{{ search_modal_id }}-input" name="{{ search.inputName }}" placeholder="{{ 'utils.search'|trans({}, 'dsfr') }}" type="search">
                                            <div aria-live="polite" class="fr-messages-group" id="{{ search_modal_id }}-input-messages"></div>
                                            <button class="fr-btn" title="{{ 'utils.search'|trans({}, 'dsfr') }}" type="submit">
                                                {{ 'utils.search'|trans({}, 'dsfr') }}
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            {% endblock %}
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    {% if header_navigation|trim or header_tools|trim %}
        <div aria-labelledby="{{ menu_id }}-button" class="fr-header__menu fr-modal" id="{{ menu_id }}">
            <div class="fr-container">
                <button aria-controls="{{ menu_id }}" class="fr-btn--close fr-btn" title="{{ 'utils.close'|trans({}, 'dsfr') }}" type="button">
                    {{ 'utils.close'|trans({}, 'dsfr') }}
                </button>
                <div class="fr-header__menu-links"></div>
                {% if header_navigation|trim %}
                    <twig:UxDsfr:Header:Nav id="{{ navigation_id }}">
                        {{ header_navigation }}
                    </twig:UxDsfr:Header:Nav>
                {% endif %}
            </div>
        </div>
    {% endif %}
</header>
