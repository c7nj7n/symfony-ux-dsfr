{% set variants = [
    sticky is same as(true) ? 'fr-sidemenu--sticky',
    sticky is same as('full-height') ? 'fr-sidemenu--sticky-full-height',
    right ? 'fr-sidemenu--right',
]|filter(c => c) %}
<nav {{ attributes.defaults({
    'class': (['fr-sidemenu']|merge(variants))|join(' '),
    'role': 'navigation',
}|merge(title ? {'aria-labelledby': id ~ '-title'} : {})) }}>
    <div class="fr-sidemenu__inner">
        <button aria-controls="{{ id }}-wrapper" aria-expanded="false" class="fr-sidemenu__btn" type="button">{{ buttonLabel ?? 'sidemenu.button'|trans({}, 'dsfr') }}</button>
        <div class="fr-collapse" id="{{ id }}-wrapper">
            {% if title %}
                <div class="fr-sidemenu__title" id="{{ id }}-title">{{ title }}</div>
            {% endif %}
            {% block content %}{% endblock %}
        </div>
    </div>
</nav>
