<div {{ attributes.defaults({ class: 'fr-skiplinks' }) }}>
    <nav aria-label="{{ 'skiplinks.label'|trans({}, 'dsfr') }}" class="fr-container" role="navigation">
        <ul class="fr-skiplinks__list">
            {% for link in links %}
                <li><a class="fr-link" href="{{ link.href }}">{{ link.label }}</a></li>
            {% endfor %}
        </ul>
    </nav>
</div>
