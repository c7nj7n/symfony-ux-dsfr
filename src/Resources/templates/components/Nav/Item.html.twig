{% set link_content %}{% block content %}{% endblock %}{% endset %}
{% set sub_menu %}{% block sub_menu %}{% endblock %}{% endset %}
{% set is_current = current ?? (href is not null and app.request.pathInfo === href) %}
<li {{ attributes.defaults({ class: 'fr-nav__item' }) }}>
    {% if sub_menu|trim %}
        {% set subId = this.getSubMenuId() %}
        <button aria-controls="{{ subId }}" aria-expanded="false" class="fr-nav__btn" type="button"{% if is_current %} aria-current="true"{% endif %}>
            {{ link_content }}
        </button>
        <div class="fr-collapse fr-menu" id="{{ subId }}">
            <ul class="fr-menu__list">
                {{ sub_menu }}
            </ul>
        </div>
    {% elseif href %}
        <a class="fr-nav__link" href="{{ href }}"{% if is_current %} aria-current="page"{% endif %}>
            {{ link_content }}
        </a>
    {% else %}
        <span class="fr-nav__link">
            {{ link_content }}
        </span>
    {% endif %}
</li>
